        <!-- NODO: AWS IAM (PRIVADO) -->
        <mxCell id="node_iam" value="&lt;span style=&quot;background-color:#4C1D95;color:#F3E8FF;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;PRIVADO · IAM&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#F8FAFC;&quot;&gt;AWS IAM Execution Role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#FCA5A5;font-size:11px;&quot;&gt;Principio de Mínimo Privilegio&lt;/span&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#CBD5E1;margin-top:6px;&quot;&gt;• Solo AWSLambdaBasicExecutionRole&lt;br&gt;• Sin permisos a S3, DynamoDB ni EC2&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131F36;strokeColor=#F87171;strokeWidth=1.8;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="190" width="350" height="130" as="geometry" />
        </mxCell>

        <!-- NODO: AMAZON CLOUDWATCH (PRIVADO) -->
        <mxCell id="node_cloudwatch" value="&lt;span style=&quot;background-color:#4C1D95;color:#F3E8FF;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;PRIVADO&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#F8FAFC;&quot;&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#E879F9;font-size:11px;&quot;&gt;Logs y Monitoreo Operativo Privado&lt;/span&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#CBD5E1;margin-top:6px;&quot;&gt;• Trazas privadas /aws/lambda/simulador-manta&lt;br&gt;• Métricas de duración, RAM e invocaciones&lt;br&gt;• Always Free: 5 GB/mes de ingesta de logs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131F36;strokeColor=#C084FC;strokeWidth=1.8;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="345" width="350" height="150" as="geometry" />
        </mxCell>

        <!-- NODO: AWS BUDGETS (PRIVADO DIA 1) -->
        <mxCell id="node_budgets" value="&lt;span style=&quot;background-color:#4C1D95;color:#F3E8FF;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;PRIVADO · ACTIVO DÍA 1&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#F8FAFC;&quot;&gt;AWS Budgets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#34D399;font-size:11px;&quot;&gt;Control y Alerta Presupuestaria&lt;/span&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#CBD5E1;margin-top:6px;&quot;&gt;• Alerta activa desde el Día 1 ($1.00 USD/mes)&lt;br&gt;• Gasto real SpookyThon 2026: $0.00 USD (Free Tier)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131F36;strokeColor=#10B981;strokeWidth=1.8;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="520" width="350" height="130" as="geometry" />
