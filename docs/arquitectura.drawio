        <!-- NODO: AWS LAMBDA FUNCTION URL -->
        <mxCell id="node_lambda" value="&lt;span style=&quot;background-color:#065F46;color:#ECFDF5;padding:2px 6px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;ENDPOINT PÚBLICO HTTPS&lt;/span&gt; &lt;span style=&quot;background-color:#4C1D95;color:#F3E8FF;padding:2px 6px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;RUNTIME PRIVADO&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#F8FAFC;&quot;&gt;AWS Lambda + Function URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#FB923C;font-size:11px;&quot;&gt;Motor Serverless Python 3.12 para Monte Carlo (512 MB)&lt;/span&gt;&lt;hr size=&quot;1&quot; color=&quot;#1E293B&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#CBD5E1;&quot;&gt;• infra/lambda_simulador.py (solo json, math, random)&lt;br&gt;• CORS abierto (*) para OPTIONS y POST JSON&lt;br&gt;• 3 estrategias SEIR en grafo de 8 nodos de Manta&lt;br&gt;• Regla estricta: vacuna 100% solo a población 🟢 Sana&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131F36;strokeColor=#FB923C;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="425" y="425" width="355" height="225" as="geometry" />
        </mxCell>

