        <!-- NODO: USUARIO / JURADO (PUBLICO) -->
        <mxCell id="node_user" value="&lt;span style=&quot;background-color:#065F46;color:#ECFDF5;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;PÚBLICO&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#F8FAFC;&quot;&gt;Usuario / Jurado / COE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#38BDF8;font-size:11px;&quot;&gt;Navegador Web (HTTPS / TLS 1.3)&lt;/span&gt;&lt;hr size=&quot;1&quot; color=&quot;#1E293B&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#CBD5E1;&quot;&gt;• Mapa SVG animado (8 barrios Manta)&lt;br&gt;• Panel Anti-Brote Sorpresa&lt;br&gt;• Curvas SEIR + Rangos [Min - Max]&lt;br&gt;• Informe Ejecutivo para el Alcalde&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131F36;strokeColor=#38BDF8;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="250" height="220" as="geometry" />
        </mxCell>

        <!-- NODO: FALLBACK INTELIGENTE LOCAL -->
        <mxCell id="node_fallback" value="&lt;span style=&quot;background-color:#064E3B;color:#A7F3D0;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;PÚBLICO · CLIENTE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#F8FAFC;&quot;&gt;⚡ Fallback Inteligente Local&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#34D399;font-size:11px;&quot;&gt;Motor JS Determinista mulberry32(2026)&lt;/span&gt;&lt;hr size=&quot;1&quot; color=&quot;#1E293B&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#CBD5E1;&quot;&gt;• Activo al instante si cae la red o URL vacía&lt;br&gt;• 50 corridas Monte Carlo en ~12 ms&lt;br&gt;• Cero errores visibles durante el pitch&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131F36;strokeColor=#10B981;strokeWidth=1.8;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="435" width="250" height="220" as="geometry" />
        </mxCell>

