        <mxCell id="c3" value="&lt;b&gt;🧟 Operación Contención Manta · Arquitectura AWS Serverless Final&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#94a3b8'&gt;SpookyThon 2026 · Track B · us-east-2 · Gasto real: $0.00 USD&lt;/span&gt;" style="text;html=1;align=center;fontSize=22;fontColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="200" y="10" width="1000" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="🌐 ZONA PÚBLICA (Internet · HTTPS / TLS 1.3)" style="rounded=1;arcSize=4;dashed=1;dashPattern=10 6;strokeWidth=2;strokeColor=#38bdf8;fillColor=#38bdf8;opacity=100;fillOpacity=6;fontColor=#38bdf8;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1340" height="240" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b style='font-size:15px'&gt;👤 Navegador del Usuario / Jurado&lt;/b&gt;&lt;br&gt;Leaflet GIS (Esri Calles / Satélite) + 🖥️ Fullscreen&lt;br&gt;Chart.js (bandas Mín–Máx + SEIR)&lt;br&gt;🧠 Auto-Optimizador Presupuestario IA&lt;br&gt;📄 Informe Ejecutivo para el Alcalde&lt;br&gt;QA: Anti-Spam · clamping · seguros NaN/÷0&lt;br&gt;&lt;font color='#6ee7b7'&gt;⚡ Fallback Local mulberry32(seed) + FNV-1a&lt;/font&gt;" style="rounded=1;arcSize=8;strokeWidth=1.6;strokeColor=#38bdf8;fillColor=#0b1324;fontColor=#e2e8f0;fontSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="430" height="184" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b style='font-size:15px'&gt;☁️ AWS Amplify Hosting&lt;/b&gt;&lt;br&gt;CDN global + HTTPS&lt;br&gt;index.html · styles.css · app.js&lt;br&gt;Sin buckets S3 públicos&lt;br&gt;&lt;font color='#a78bfa'&gt;prod.d1yapm4cwo9o63.amplifyapp.com&lt;/font&gt;" style="rounded=1;arcSize=8;strokeWidth=1.6;strokeColor=#a78bfa;fillColor=#0b1324;fontColor=#e2e8f0;fontSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="134" width="320" height="152" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b style='font-size:15px'&gt;🌤️ Open-Meteo API (externa)&lt;/b&gt;&lt;br&gt;Temperatura · Humedad · Precipitación (Manta)&lt;br&gt;Calibración β (curva de Brière)&lt;br&gt;&lt;font color='#fde68a'&gt;Fallback: AbortController 3,500 ms → 26 °C / 78 %&lt;/font&gt;" style="rounded=1;arcSize=8;strokeWidth=1.6;strokeColor=#fbbf24;fillColor=#0b1324;fontColor=#e2e8f0;fontSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="134" width="390" height="152" as="geometry"/></mxCell>
        <mxCell id="c8" value="⚙️ CÓMPUTO SERVERLESS (URL pública HTTPS · runtime aislado)" style="rounded=1;arcSize=4;dashed=1;dashPattern=10 6;strokeWidth=2;strokeColor=#f97316;fillColor=#f97316;opacity=100;fillOpacity=6;fontColor=#f97316;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="1340" height="200" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b style='font-size:15px'&gt;λ AWS Lambda Function URL · Python 3.12 · 512 MB · 20 s&lt;/b&gt;&lt;br&gt;infra/lambda_simulador.py · SEIR + Escudo de Centralidad · CORS · clamping&lt;br&gt;&lt;font color='#fdba74'&gt;Fan-Out: Worker 1 | Worker 2 | Worker 3 | Worker 4 | Worker 5 (Promise.all)&lt;/font&gt;&lt;br&gt;Sub-semillas particionadas · reducción FNV-1a idéntica" style="rounded=1;arcSize=8;strokeWidth=1.6;strokeColor=#f97316;fillColor=#0b1324;fontColor=#e2e8f0;fontSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="740" height="150" as="geometry"/></mxCell>
        <mxCell id="c10" value="🔒 ZONA PRIVADA · IAM Least Privilege (sin acceso público · cifrado KMS)" style="rounded=1;arcSize=4;dashed=1;dashPattern=10 6;strokeWidth=2;strokeColor=#34d399;fillColor=#34d399;opacity=100;fillOpacity=6;fontColor=#34d399;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="575" width="1340" height="210" as="geometry"/></mxCell>
