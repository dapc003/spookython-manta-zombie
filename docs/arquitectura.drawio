        <mxCell id="c12" value="&lt;b style='font-size:15px'&gt;🗄️ Amazon DynamoDB&lt;/b&gt;&lt;br&gt;Tabla SpookyThonSimulations&lt;br&gt;Registro inmutable de corridas&lt;br&gt;Seed · Mode · SavedLivesMean · HashFirma&lt;br&gt;&lt;font color='#6ee7b7'&gt;On-Demand · SSE · PITR ✔&lt;/font&gt;&lt;br&gt;IAM: PutItem / Query" style="rounded=1;arcSize=8;strokeWidth=1.6;strokeColor=#34d399;fillColor=#0b1324;fontColor=#e2e8f0;fontSize=12;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="614" width="300" height="152" as="geometry"/></mxCell>
