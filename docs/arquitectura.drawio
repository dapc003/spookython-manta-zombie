        <!-- NODO: AWS AMPLIFY HOSTING (PUBLICO) -->
        <mxCell id="node_amplify" value="&lt;span style=&quot;background-color:#065F46;color:#ECFDF5;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:bold;&quot;&gt;PÚBLICO · HTTPS&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#F8FAFC;&quot;&gt;AWS Amplify Hosting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#FBBF24;font-size:11px;&quot;&gt;Frontend Web Estático Público con HTTPS&lt;/span&gt;&lt;hr size=&quot;1&quot; color=&quot;#1E293B&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#CBD5E1;&quot;&gt;• Sirve src/index.html, styles.css y app.js&lt;br&gt;• CDN CloudFront integrado + SSL/TLS 1.3&lt;br&gt;• Sin Buckets S3 públicos ni claves en cliente&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131F36;strokeColor=#FF9900;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="425" y="190" width="355" height="195" as="geometry" />
