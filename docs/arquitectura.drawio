      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- BANNER DE TITULO -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size:16px;color:#F8FAFC;&quot;&gt;OPERACIÓN CONTENCIÓN MANTA — ARQUITECTURA CLOUD SERVERLESS (AWS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#94A3B8;&quot;&gt;SpookyThon 2026 · Track B: La Plaga Zombie · Separación Explícita de Componentes PÚBLICOS (HTTPS) y PRIVADOS (IAM / Gobernanza)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#132342;strokeColor=#334155;strokeWidth=1.5;align=left;spacingLeft=18;" vertex="1" parent="1">
